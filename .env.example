# Public and build-time environment variables.
#
# Copy to `.env` and fill in values, or export them in your shell / CI.
# `.env` (and every other `.env*`) is gitignored; only this template is tracked.
#
# Secrets do NOT belong here. Server secrets (e.g. CONTACT_API_KEY) go in
# `.dev.vars` locally (template: `.dev.vars.example`) and `wrangler secret put
# <NAME>` in production; they are declared in astro.config.mjs `env.schema`.
# See SECURITY.md for the full map.

# Production URL for the sitemap, canonical links, and OG tags (e.g.
# https://yoursite.com). Overrides `brand.url` in src/lib/site-config.ts;
# leave unset to fall back to the brand config.
PUBLIC_SITE_URL=

# Brand name and short name for the favicon / manifest generator.
# Override src/lib/site-config.ts `brand.name` / `brand.shortName`.
PUBLIC_SITE_NAME=
PUBLIC_SITE_SHORT_NAME=

# Google Search Console verification token, baked into <head> at build time.
GOOGLE_SITE_VERIFICATION=
