{
  // Deployed Worker name, served at <name>.<account-subdomain>.workers.dev
  "name": "fractal-viewer",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-06-17",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Served from its *.workers.dev URL, so that route stays on. To lock the site to a
  // custom domain instead (Settings -> Domains & Routes -> Custom Domains), add
  // "workers_dev": false here. On Wrangler 4.44+ "preview_urls" then default-matches
  // workers_dev and goes off too; add "preview_urls": true to keep per-branch preview URLs
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // "none": an asset miss falls through to the Worker, which renders the SSR
    // 404 page (404.astro is prerender=false); no static 404.html is emitted now
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  }
}
