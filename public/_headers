# Security + caching headers for STATIC responses, applied by the Cloudflare
# adapter: at the edge in production and locally via `astro preview` /
# `wrangler dev` (workerd). Plain `astro dev` does not apply them.
# Server-rendered responses never reach the asset server, so src/middleware.ts
# covers those from the same set in src/lib/security-headers.ts. Edit this file
# and that one together; src/lib/security-headers.test.ts fails if they diverge.
#
# The CSP allows `static.cloudflareinsights.com` (script-src) and
# `cloudflareinsights.com` (connect-src) for Cloudflare Web Analytics' cookieless
# beacon; remove both if Web Analytics is disabled.
#
# No iframes are used, so framing is denied outright
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; object-src 'none'; script-src 'self' 'unsafe-inline' static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# Hashed assets (content hash in filename, safe for immutable long-term caching)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts (self-hosted, rarely change)
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
