---
import { GOOGLE_SITE_VERIFICATION } from "astro:env/server";
import { localizedHTML as faviconTags } from "astro-favicons/middleware";
import JsonLd from "@/components/seo/JsonLd.astro";
import SEO, { type Props as SEOProps } from "@/components/seo/SEO.astro";
import { htmlLang, pageMeta, site } from "@/lib/site-config";
import { buildOrganizationSchema, buildWebSiteSchema } from "@/lib/structured-data";
import "../styles/global.css";

interface Props {
  seoProps?: SEOProps;
}

const { seoProps = {} } = Astro.props;
// Configurable site-wide default; a page's own `description` (if any) overrides it.
const seo = { description: pageMeta.defaultDescription, ...seoProps };
const organizationSchema = buildOrganizationSchema(site);
const webSiteSchema = buildWebSiteSchema({
  name: site.name,
  url: site.url,
});

/*
 * Dark mode default; remove `class="dark"` from the <html> tag below for light, or add a
 * runtime theme toggle (next-themes is installed)
 *
 * Lives here rather than beside the tag because an <!-- --> comment in an Astro template
 * is markup and ships to the reader, and an expression comment cannot sit between the
 * doctype and <html>
 */
---

<!doctype html>
<html lang={htmlLang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      /* Favicons, manifest, apple-touch-icon and theme-color, emitted from the
        set astro-favicons generates (configured in astro.config.mjs).

        Injected explicitly rather than left to the integration's middleware,
        which bails unless the response carries `X-Astro-Route-Type: page`. Astro 7
        does not set that header, so nothing was injected: the generated files
        shipped but no page linked them, which left the manifest unreachable and
        the site with no theme-color. `localizedHTML` is the integration's own
        documented escape hatch, so this stays in step with its config rather than
        hardcoding a list of tags.
        `tests/build/head-icons.test.ts` fails if these stop reaching the HTML */
    }
    <Fragment set:html={faviconTags(Astro.currentLocale)} />
    {
      /* Google Search Console: set the GOOGLE_SITE_VERIFICATION env var at build time after registering the domain (baked into this static head) */
    }
    {
      GOOGLE_SITE_VERIFICATION && (
        <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />
      )
    }
    <SEO {...seo} />
    <JsonLd schema={[organizationSchema, webSiteSchema]} />
    <slot name="head" />
  </head>
  <body>
    <nav aria-label="Skip navigation">
      <a
        href="#main-content"
        class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-60 focus:bg-primary focus:text-primary-foreground focus:px-4 focus:py-2 focus:rounded">
        Skip to content
      </a>
    </nav>
    <slot />
    <noscript>
      <style>
        .reveal,
        .reveal [data-stagger] {
          opacity: 1;
          transform: none;
        }
      </style>
    </noscript>
  </body>
</html>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add("revealed");
          observer.unobserve(entry.target);
        }
      }
    },
    { threshold: 0.15, rootMargin: "0px 0px -60px 0px" },
  );
  document.querySelectorAll(".reveal").forEach((el) => {
    // Index any opt-in stagger children by position so each delays a step
    // after the parent reveals (the .reveal [data-stagger] CSS reads it)
    el.querySelectorAll("[data-stagger]").forEach((child, i) => {
      if (child instanceof HTMLElement) child.style.setProperty("--stagger-index", String(i));
    });
    observer.observe(el);
  });
</script>
