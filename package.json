{
  "name": "fractal-viewer",
  "version": "2.4.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.1",
    "pnpm": ">=11.10.0"
  },
  "packageManager": "pnpm@11.10.0+sha512.0b7f8b98060031904c017e3a41eb187a16d40eeb829b95c4f8cb03681761fc4ab53dd219115b9b447f4dce1a05a214764461e7d3703392a9f32f9511ce8c86c8",
  "scripts": {
    "astro": "astro",
    "build": "wrangler types && astro build",
    "check:deps": "trivy fs --severity HIGH,CRITICAL --exit-code 1 --scanners vuln --skip-dirs node_modules .",
    "check": "biome check --write .",
    "check:astro": "prettier --check 'src/**/*.astro'",
    "check:ci": "biome ci .",
    "check:commitlint": "if git rev-parse --verify -q \"origin/${BASE_REF:-main}\" >/dev/null 2>&1; then pnpm exec commitlint --from \"origin/${BASE_REF:-main}\" --to HEAD --verbose; else echo \"check:commitlint: origin/${BASE_REF:-main} not found; skipping (push to a remote first)\"; fi",
    "check:pr-title": "echo \"$PR_TITLE\" | pnpm exec commitlint --verbose",
    "check:sast": "docker run --rm -v \"$PWD:/src\" semgrep/semgrep semgrep ci --config p/javascript --config p/typescript --config p/react --config p/security-audit --config p/owasp-top-ten --exclude-rule yaml.github-actions.security.github-actions-mutable-action-tag.github-actions-mutable-action-tag",
    "check:secrets": "gitleaks git --no-banner --redact",
    "check:secrets:pr": "gitleaks git --log-opts=\"$PR_BASE_SHA..$PR_HEAD_SHA\" --no-banner --redact",
    "check:secrets:staged": "gitleaks git --pre-commit --staged --no-banner --redact",
    "check:staged": "biome check --write",
    "check:types": "astro sync && tsc --noEmit",
    "dev": "astro dev",
    "format": "biome format --write .",
    "format:all": "pnpm run format && pnpm run format:astro",
    "format:astro": "prettier --write 'src/**/*.astro'",
    "format:astro:staged": "prettier --write",
    "lint": "biome lint .",
    "preview": "astro preview",
    "release": "semantic-release",
    "release:dry": "GH_TOKEN=$(gh auth token) semantic-release --dry-run --branches \"$(git branch --show-current)\"",
    "test": "vitest run --project=unit --project=components",
    "test:unit": "vitest run --project=unit",
    "test:components": "vitest run --project=components",
    "test:watch": "vitest --project=unit --project=components",
    "test:coverage": "vitest run --project=unit --project=components --coverage",
    "test:build": "vitest run --project=build",
    "test:e2e": "playwright test",
    "test:e2e:accessibility": "playwright test --grep \"Accessibility\"",
    "test:e2e:functional": "playwright test --grep-invert \"Accessibility\"",
    "preflight:security": "pnpm run check:secrets && pnpm run check:sast && pnpm run check:deps",
    "preflight:quality": "pnpm run check:commitlint && pnpm run check:ci && pnpm run check:astro && pnpm run check:types",
    "preflight:unit": "pnpm run test",
    "preflight:build": "pnpm run build && pnpm run test:build",
    "preflight:e2e": "pnpm run test:e2e",
    "preflight": "pnpm run preflight:security && pnpm run preflight:quality && pnpm run preflight:unit && pnpm run preflight:build && pnpm run preflight:e2e",
    "generate-types": "wrangler types",
    "prepare": "test -d .git && lefthook install || true"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.1.7",
    "@astrojs/react": "^6.0.2",
    "@astrojs/sitemap": "^3.7.3",
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.7.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^8.21.3",
    "astro": "^7.1.6",
    "astro-embed": "^0.13.1",
    "astro-expressive-code": "^0.44.1",
    "astro-favicons": "^3.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-auto-height": "^8.6.0",
    "embla-carousel-auto-scroll": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-class-names": "^8.6.0",
    "embla-carousel-fade": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.28.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.84.0",
    "schema-dts": "^2.0.0",
    "sharp": "^0.35.2",
    "shiki": "^4.4.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "vaul-base": "^1.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "2.5.6",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.1.0",
    "@playwright/test": "^1.62.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^13.1.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "cheerio": "^1.2.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "happy-dom": "^20.11.1",
    "lefthook": "^2.1.10",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "semantic-release": "^25.0.8",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
